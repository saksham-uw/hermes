menu "Hermes Configuration"

    config HERMES_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_WIFI"

    config HERMES_WIFI_PASSWORD
        string "WiFi password"
        default "YOUR_PASSWORD"

    config HERMES_IOT_ENDPOINT
        string "AWS IoT Core ATS endpoint"
        default "acp99wijypwjp-ats.iot.us-east-1.amazonaws.com"

    config HERMES_USER_ID
        string "Hermes user id (topic prefix)"
        default "saksham"

    config HERMES_THING_NAME
        string "IoT Thing / MQTT client id"
        default "hermes-device"

    config HERMES_UI_CONSOLE
        bool "Also log UI state to UART console"
        default n
        help
            LCD + touch is the primary UI. Enable this for extra UART dumps.

    config HERMES_BOOT_GPIO
        int "BOOT GPIO (active low)"
        default 0

endmenu
