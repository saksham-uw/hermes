{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "redirects": [
    {
      "source": "/downloads/HERMES.zip",
      "destination": "https://github.com/saksham-uw/hermes/releases/latest/download/HERMES.zip",
      "permanent": false
    },
    {
      "source": "/downloads/appcast.xml",
      "destination": "https://github.com/saksham-uw/hermes/releases/latest/download/appcast.xml",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/auth/github/callback",
      "destination": "/api/oauth?provider=github&action=callback"
    },
    {
      "source": "/auth/slack/callback",
      "destination": "/api/oauth?provider=slack&action=callback"
    }
  ]
}
