# AWS
AWS_REGION=us-east-1
HERMES_IOT_ENDPOINT=acp99wijypwjp-ats.iot.us-east-1.amazonaws.com
HERMES_USER_ID=saksham
HERMES_THING_NAME=hermes-device

# Bridge MQTT client id (must be unique; IAM policy allows hermes-bridge-*)
HERMES_BRIDGE_CLIENT_ID=hermes-bridge-1

# Codex app-server
HERMES_CODEX_WS_URL=ws://127.0.0.1:4520
HERMES_CODEX_AUTH_TOKEN=
HERMES_CODEX_SPAWN=true
HERMES_CODEX_CWD=

# Local inbox for Cursor observe hooks
HERMES_INBOX_HOST=127.0.0.1
HERMES_INBOX_PORT=8741

# Local Whisper on EC2 (preferred). Run: bash scripts/setup-stt-ec2.sh
HERMES_STT_URL=http://127.0.0.1:8765

# Optional fallback only — not required if local STT is running
OPENAI_API_KEY=
