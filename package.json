{
  "name": "hermes",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Hermes pocket-device firmware; legacy Codex/Cursor tooling retained dormant",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "avatar:sync": "node scripts/sync-avatar-lab.mjs",
    "avatar:generate": "node scripts/generate-avatar-assets.mjs",
    "actions:build": "npm run build -w @hermes/actions-service",
    "actions:start": "npm run start -w @hermes/actions-service",
    "actions:test": "npm run test -w @hermes/actions-service",
    "actions:deploy": "bash scripts/deploy-actions-lambda.sh",
    "legacy:build": "npm run build -w @hermes/protocol && npm run build -w @hermes/bridge",
    "legacy:dev:bridge": "npm run dev -w @hermes/bridge",
    "legacy:start:bridge": "npm run start -w @hermes/bridge",
    "legacy:provision:iot": "bash deploy/iot/provision.sh",
    "legacy:simulate:device": "node scripts/simulate-device.mjs",
    "legacy:typecheck": "npm run typecheck -w @hermes/protocol && npm run typecheck -w @hermes/bridge"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@bible-strong/avatar-core": "0.1.0",
    "sharp": "0.34.3"
  }
}
